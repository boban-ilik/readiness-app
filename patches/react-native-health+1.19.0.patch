diff --git a/node_modules/react-native-health/RCTAppleHealthKit/RCTAppleHealthKit+Methods_Reproductive.m b/node_modules/react-native-health/RCTAppleHealthKit/RCTAppleHealthKit+Methods_Reproductive.m
