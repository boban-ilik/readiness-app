---
import '../styles/global.css';
import { organization, founder, website } from '../schema';

interface Props {
  title?: string;
  description?: string;
  /** Page-specific JSON-LD nodes, merged into the site-wide @graph. */
  schema?: Record<string, unknown>[];
}

const {
  title = 'Readiness | A readiness score for the watch you already own',
  description =
    'Daily readiness scores from your HRV, resting heart rate and sleep, read from Apple Health. Works with Apple Watch, Garmin, Polar, Fitbit and more. No extra hardware.',
  schema = [],
} = Astro.props;

const APP_STORE_URL = 'https://apps.apple.com/app/id6760478506';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [organization, founder, website, ...schema],
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <!-- Archivo is served from this site (public/fonts), so no visitor IP goes to Google. -->
    <link rel="preload" href="/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={jsonLd} />

    <!-- Google Analytics loads only after the visitor accepts (cookie banner at the end of body). -->
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href="/">Readiness<span class="dot">.</span></a>
        <nav class="site-nav">
          <a href="/#features">Features</a>
          <a href="/#how">How it works</a>
          <a href="/#science">Science</a>
          <a href="/#pricing">Pricing</a>
          <a href="/#faq">FAQ</a>
          <a href="/blog/">Blog</a>
        </nav>
        <a class="btn btn-sm" href={APP_STORE_URL}>Download</a>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-cols">
          <div>
            <a class="wordmark" href="/">Readiness<span class="dot">.</span></a>
            <p class="footer-tagline">
              Know when to push. Know when to rest. Your daily recovery score, from the gear you already own.
            </p>
          </div>
          <div>
            <h4>Product</h4>
            <ul>
              <li><a href="/#features">Features</a></li>
              <li><a href="/#pricing">Pricing</a></li>
              <li><a href="/blog/">Blog</a></li>
              <li><a href={APP_STORE_URL}>Download</a></li>
            </ul>
          </div>
          <div>
            <h4>Support</h4>
            <ul>
              <li><a href="/support/">Support</a></li>
              <li><a href="/#faq">FAQ</a></li>
              <li><a href="mailto:support@thereadiness.app">support@thereadiness.app</a></li>
            </ul>
          </div>
          <div>
            <h4>Trust</h4>
            <ul>
              <li><a href="/privacy/">Privacy Policy</a></li>
              <li><a href="/#science">Sources</a></li>
              <li><button type="button" class="link-button" data-cookie-settings>Cookie settings</button></li>
            </ul>
          </div>
        </div>
        <div class="footer-legal">
          <span>© 2026 Readiness</span>
          <span>Readiness is a general wellness app and is not a substitute for medical advice.</span>
        </div>
      </div>
    </footer>

    <div class="cookie-banner" id="cookie-banner" role="region" aria-label="Cookie choice" hidden>
      <p>
        We use Google Analytics cookies to see which pages people read. Nothing is set unless you accept.
        <a href="/privacy/">Privacy Policy</a>
      </p>
      <div class="cookie-actions">
        <button type="button" class="cookie-btn" data-cookie-choice="denied">Decline</button>
        <button type="button" class="cookie-btn" data-cookie-choice="granted">Accept</button>
      </div>
    </div>

    <script is:inline>
      (function () {
        var KEY = 'readiness_cookie_consent';
        var GA_ID = 'G-7N5S436JZ0';
        var banner = document.getElementById('cookie-banner');

        function read() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
        function save(v) { try { localStorage.setItem(KEY, v); } catch (e) {} }

        function loadAnalytics() {
          if (window.__readinessGA) return;
          window.__readinessGA = true;
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { window.dataLayer.push(arguments); };
          window.gtag('js', new Date());
          window.gtag('config', GA_ID);
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
          document.head.appendChild(s);
        }

        // Withdrawing consent removes the cookies Google Analytics set.
        function clearAnalyticsCookies() {
          document.cookie.split(';').forEach(function (c) {
            var name = c.split('=')[0].trim();
            if (name.indexOf('_ga') !== 0) return;
            ['', '; domain=thereadiness.app', '; domain=.thereadiness.app'].forEach(function (d) {
              document.cookie = name + '=; Max-Age=0; path=/' + d;
            });
          });
        }

        function choose(value) {
          var wasGranted = read() === 'granted';
          save(value);
          banner.hidden = true;
          if (value === 'granted') { loadAnalytics(); return; }
          // Stop the running tag first, or it rewrites its cookie before the reload.
          window['ga-disable-' + GA_ID] = true;
          clearAnalyticsCookies();
          // The already-running tag would keep sending; a reload drops it.
          if (wasGranted) window.location.reload();
        }

        document.querySelectorAll('[data-cookie-choice]').forEach(function (b) {
          b.addEventListener('click', function () { choose(b.getAttribute('data-cookie-choice')); });
        });
        document.querySelectorAll('[data-cookie-settings]').forEach(function (b) {
          b.addEventListener('click', function () { banner.hidden = false; });
        });

        var current = read();
        if (current === 'granted') loadAnalytics();
        else if (current === 'denied') clearAnalyticsCookies();
        else banner.hidden = false;
      })();
    </script>
  </body>
</html>
